# Docker Compose Environment Variables
# Copy this file to .env and fill in the values

# Backend Configuration
# Generate a secure random key for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Frontend URL (used for CORS)
# In production, this should be your actual frontend domain
FRONTEND_URL=http://localhost

# Send the session cookie only over HTTPS. Defaults to true when unset.
# The compose files already set this per environment (false locally, true in prod);
# only override here if you serve dev over a non-localhost host or use HTTPS locally.
# SESSION_COOKIE_SECURE=false

# MongoDB Configuration (using docker-compose defaults)
# These are already set in docker-compose.yml, but you can override them here if needed
# MONGODB_HOSTNAME=mongodb
# MONGODB_PORT=27017
# MONGODB_USERNAME=admin
# MONGODB_PASSWORD=password
# MONGODB_DATABASE=wizcord

# Redis Configuration (using docker-compose defaults)
# REDIS_URL=redis://redis:6379

# Seconds an SSE stream is held open before the server closes it and the browser
# reconnects.
# SSE_MAX_STREAM_SECONDS=600
